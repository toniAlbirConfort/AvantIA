{$APP_DOMAIN} {
    encode zstd gzip
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /webhooks/* {
        reverse_proxy api:8000
    }
    handle /health {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
