POSTGRES_PASSWORD=change-this-long-random-password
DATABASE_URL=postgresql+psycopg://avantia:change-this-long-random-password@db:5432/avantia
APP_SECRET=change-this-to-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
APP_DOMAIN=avantia.example.com
AVANTIA_API_PORT=18100
AVANTIA_FRONTEND_PORT=15173
AVANTIA_GOWA_PORT=3002
PUBLIC_BASE_URL=https://avantia.example.com
CORS_ORIGIN=http://localhost:15173
GOWA_BASIC_AUTH=change-user:change-password
GOWA_WEBHOOK_SECRET=change-this-to-a-random-webhook-secret
GOWA_DEVICE_ID=avantia-device
GOWA_INTERNAL_CHAT_ID=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_INITIAL_BACKFILL=0
MAIL_MESSAGE_URL_TEMPLATE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
BOOKING_SENDER_DOMAINS=booking.com
# Automatic reservation export from the logged-in Chrome profile on the production server.
AVANTIO_EXPORT_URL=
AVANTIO_SYNC_INTERVAL_HOURS=6
AVANTIO_IMPORT_DIR=
# Compose defaults: local uses the SSH tunnel on host.docker.internal:11435;
# production overrides this to host.docker.internal:11434.
OLLAMA_URL=
OLLAMA_MODEL=dania:16k
CSV_COLUMN_MAP={}
AVAILABILITY_MAX_AGE_HOURS=6
AVAILABILITY_SOURCE=csv
OVERDUE_MINUTES=15
