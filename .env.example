POSTGRES_PASSWORD=change-this-long-random-password
DATABASE_URL=postgresql+psycopg://avantia:change-this-long-random-password@db:5432/avantia
APP_SECRET=change-this-to-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
APP_DOMAIN=avantia.example.com
AVANTIA_API_PORT=18100
AVANTIA_FRONTEND_PORT=15173
AVANTIA_GOWA_PORT=3002
PUBLIC_BASE_URL=https://avantia.example.com
CORS_ORIGIN=http://localhost:15173
GOWA_BASIC_AUTH=change-user:change-password
GOWA_WEBHOOK_SECRET=change-this-to-a-random-webhook-secret
GOWA_DEVICE_ID=avantia
GOWA_INTERNAL_CHAT_ID=
# Configure this same secret in the GitHub repository webhook settings.
GITHUB_DEPLOY_WEBHOOK_SECRET=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_INITIAL_BACKFILL=0
MAIL_MESSAGE_URL_TEMPLATE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Display name shown next to SMTP_FROM, e.g. Albir Confort Holidays.
SMTP_FROM_NAME=
SMTP_STARTTLS=true
BOOKING_SENDER_DOMAINS=booking.com
INTERNAL_SENDER_DOMAINS=albirconfort.es,albirconfort.com,albirconfort-holidays.com
INTERNAL_PHONE_NUMBERS=
# Out-of-hours acknowledgement for new customer enquiries: off, shadow (log only) or send.
# Nights (NIGHT_START..NIGHT_END) and whole weekends count as out of hours.
AUTO_REPLY_MODE=off
AUTO_REPLY_TIMEZONE=Europe/Madrid
AUTO_REPLY_NIGHT_START=20:00
AUTO_REPLY_NIGHT_END=08:00
AUTO_REPLY_MAX_AGE_MINUTES=60
AUTO_REPLY_SIGNATURE=
# Company banner below the text (backend/app/assets/auto_reply_banner.png) and its link.
AUTO_REPLY_BANNER=true
AUTO_REPLY_BANNER_URL=https://albirconfort-holidays.com/
# IMAP folder that keeps a copy of each acknowledgement sent; empty = no copy.
AUTO_REPLY_SENT_FOLDER=
# Automatic reservation export from the logged-in Chrome profile on the production server.
AVANTIO_EXPORT_URL=
AVANTIO_SYNC_INTERVAL_HOURS=6
AVANTIO_IMPORT_DIR=
# Alert when an email consultation is not registered in Avantio: off or shadow (log only).
# Checked after every reservation import; office time (the auto-reply night is off-hours).
REGISTRATION_ALERT_MODE=off
REGISTRATION_ALERT_DELAY_MINUTES=60
REGISTRATION_ALERT_LOOKBACK_DAYS=14
# Compose defaults: local uses the SSH tunnel on host.docker.internal:11435;
# production overrides this to host.docker.internal:11434.
OLLAMA_URL=
OLLAMA_MODEL=dania:16k
CSV_COLUMN_MAP={}
AVAILABILITY_MAX_AGE_HOURS=6
AVAILABILITY_SOURCE=csv
OVERDUE_MINUTES=15
